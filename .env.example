# Shared application configuration
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# App/database runtime config used by both backend services
DB_HOST=mysql
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT settings shared between Node auth and PHP task service
JWT_SECRET=
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY_DAYS=30

# Optional app settings
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
